[
 {"id":"1A","kind":"VO","sp":"narrator","s":2,"e":8,"t":"ஒரு கம்பின் ஓசையில் ஒரு தலைமுறையின் நினைவு இருக்கிறது."},
 {"id":"1B","kind":"VO","sp":"narrator","s":2,"e":7,"t":"அந்த ஓசை இன்றும் பயிற்சிக் கூடத்தில் கேட்கிறது."},
 {"id":"1C","kind":"VO","sp":"narrator","s":1.5,"e":8,"t":"அந்தப் பயிற்சியின் பின்னால் ஓர் ஆசானின் வாழ்நாள் உழைப்பு இருக்கிறது."},
 {"id":"1D","kind":"VO","sp":"narrator","s":3,"e":6.5,"t":"அவர் ஸ்ரீ எஸ். ஆறுமுகம்."},
 {"id":"2A","kind":"VO","sp":"narrator","s":2,"e":8,"t":"மலேசியாவின் தோட்டப்புறத்தில் இந்தப் பயணம் தொடங்குகிறது."},
 {"id":"2B","kind":"VO","sp":"narrator","s":1,"e":8.5,"t":"முதலில் அவர் பார்த்தார். பார்த்ததையே மனதில் பதித்துக்கொண்டார்."},
 {"id":"2C","kind":"VO","sp":"narrator","s":2,"e":7,"t":"பிறகு ஒரு மூங்கில் கம்பைக் கையில் எடுத்தார்."},
 {"id":"2D","kind":"VO","sp":"narrator","s":2,"e":7,"t":"முதல் முயற்சியிலேயே எல்லாம் கைகூடவில்லை."},
 {"id":"3A","kind":"VO","sp":"narrator","s":2,"e":8,"t":"தடுமாறிய போதும், அவர் பயிற்சியை விடவில்லை."},
 {"id":"3B","kind":"VO","sp":"narrator","s":2,"e":7,"t":"மறுநாளும் அதே இடத்துக்கு அவர் திரும்பினார்."},
 {"id":"3C","kind":"VO","sp":"narrator","s":2,"e":7,"t":"கம்பின் பிடியிலும் காலடியிலும் கவனம் வைத்தார்."},
 {"id":"3D","kind":"VO","sp":"narrator","s":2,"e":8,"t":"நாள்தோறும் செய்த பயிற்சியே அவருக்குத் துணையானது."},
 {"id":"4A","kind":"VO","sp":"narrator","s":1.5,"e":8.5,"t":"அவர் கற்ற கலையை மற்றவர்களுக்கும் கற்றுக்கொடுக்கத் தொடங்கினார்."},
 {"id":"4B","kind":"D","sp":"teacher","s":3,"e":7,"t":"அவசரம் வேண்டாம். முதலில் நிதானமா நில்."},
 {"id":"4C","kind":"VO","sp":"narrator","s":2,"e":8,"t":"அந்தச் சிறிய வகுப்பில் பொறுமைக்கும் இடம் இருந்தது."},
 {"id":"4D","kind":"VO","sp":"narrator","s":2,"e":8,"t":"ஒரு மாணவரில் தொடங்கிய பயிற்சி ஒரு வகுப்பாக வளர்ந்தது."},
 {"id":"5A","kind":"VO","sp":"narrator","s":2,"e":7,"t":"பயிற்சியைத் தேடி வந்தவர்களிடம் அவர் சென்றார்."},
 {"id":"5B","kind":"VO","sp":"narrator","s":2,"e":7.5,"t":"அவரோடு மூங்கில் கம்புகளும் பயணம் செய்தன."},
 {"id":"5C","kind":"VO","sp":"narrator","s":2,"e":8,"t":"இன்னொரு தோட்டத்தில் புதிய மாணவர்கள் காத்திருந்தார்கள்."},
 {"id":"5D","kind":"VO","sp":"narrator","s":2,"e":7.5,"t":"இடங்கள் மாறின. பயிற்சியின் ஒழுக்கம் மாறவில்லை."},
 {"id":"6A","kind":"VO","sp":"narrator","s":2,"e":8,"t":"பயிற்சிக் கூடத்தைத் தாண்டி, கலை மேடைக்கு வந்தது."},
 {"id":"6B","kind":"D","sp":"teacher","s":3,"e":7.5,"t":"பயப்படாதே. பயிற்சியில செய்ததையே செய்."},
 {"id":"6D","kind":"VO","sp":"narrator","s":2,"e":8,"t":"மேடையிலும் தெரிந்தது அன்றாடப் பயிற்சியின் நிதானம்."},
 {"id":"7A","kind":"VO","sp":"narrator","s":2,"e":8,"t":"சிலம்பத்தைப் பற்றி அறிய ஒரு ஆய்வாளர் வந்தார்."},
 {"id":"7B","kind":"VO","sp":"narrator","s":1.5,"e":8.5,"t":"கம்பின் அசைவோடு, பயிற்சியின் ஒழுக்கத்தையும் அவர் கவனித்தார்."},
 {"id":"7C","kind":"D","sp":"researcher","s":2.5,"e":7.5,"t":"மாணவர்களுக்கு முதலில் எதைக் கற்றுக்கொடுப்பீர்கள்?"},
 {"id":"7D","kind":"D","sp":"teacher","s":3,"e":7,"t":"முதலில் ஒழுக்கம். அதுக்குப் பிறகுதான் கம்பு."},
 {"id":"8A","kind":"VO","sp":"narrator","s":1.5,"e":8.5,"t":"பயிற்சிக்கூடத்தில் தொடங்கிய உழைப்புக்கு அங்கீகாரம் கிடைத்தது."},
 {"id":"8B","kind":"VO","sp":"narrator","s":1,"e":9,"t":"அந்த அங்கீகாரம், சிலம்பத்தை வளர்த்த உழைப்புக்குக் கிடைத்த மரியாதை."},
 {"id":"8C","kind":"VO","sp":"narrator","s":2,"e":8,"t":"ஒரு தலைமுறை கற்றதை அடுத்த தலைமுறைக்குக் கொடுத்தது."},
 {"id":"8D","kind":"VO","sp":"narrator","s":2,"e":8,"t":"அங்கீகாரம் கிடைத்த பின்னும், பயிற்சி தொடர்ந்தது."},
 {"id":"9A","kind":"VO","sp":"narrator","s":2,"e":8,"t":"இப்போது அந்தக் கம்பை ஏந்துவது இன்னொரு தலைமுறை."},
 {"id":"9B","kind":"D","sp":"elder","s":3,"e":7,"t":"நிதானமா. இன்னொரு தடவை பார்ப்போம்."},
 {"id":"9C","kind":"VO","sp":"narrator","s":1.5,"e":7.5,"t":"ஆசான் கற்றுத்தந்ததை அவர்கள் தொடர்ந்து பயில்கிறார்கள்."},
 {"id":"9D","kind":"VO","sp":"narrator","s":2,"e":8,"t":"இனி இந்த மரபைத் தொடர்வது அவர்களின் பொறுப்பு."},
 {"id":"10A-1","kind":"D","sp":"elder","s":2,"e":4,"t":"நான் இல்லாத பிறகும்..."},
 {"id":"10A-2","kind":"D","sp":"elder","s":5,"e":8,"t":"சிலம்பம் உயிரோட இருக்கணும்."}
]
