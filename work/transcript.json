": 218.1, "text": " Security. There's an unbadged individual near the restricted server room.", "words": [{"w": " Security.", "s": 212.1, "e": 213.1}, {"w": " There's", "s": 213.94, "e": 214.62}, {"w": " an", "s": 214.62, "e": 214.8}, {"w": " unbadged", "s": 214.8, "e": 215.5}, {"w": " individual", "s": 215.5, "e": 216.08}, {"w": " near", "s": 216.08, "e": 216.42}, {"w": " the", "s": 216.42, "e": 216.58}, {"w": " restricted", "s": 216.58, "e": 217.08}, {"w": " server", "s": 217.08, "e": 217.6}, {"w": " room.", "s": 217.6, "e": 218.1}]}, {"start": 220.32, "end": 223.06, "text": " Let security handle suspicious activity.", "words": [{"w": " Let", "s": 220.32, "e": 221.32}, {"w": " security", "s": 221.32, "e": 221.66}, {"w": " handle", "s": 221.66, "e": 222.0}, {"w": " suspicious", "s": 222.0, "e": 222.46}, {"w": " activity.", "s": 222.46, "e": 223.06}]}, {"start": 227.36, "end": 230.96, "text": " See something? Say something? Security starts with you.", "words": [{"w": " See", "s": 227.36, "e": 228.36}, {"w": " something?", "s": 228.36, "e": 228.66}, {"w": " Say", "s": 229.06, "e": 229.16}, {"w": " something?", "s": 229.16, "e": 229.44}, {"w": " Security", "s": 229.94, "e": 230.32}, {"w": " starts", "s": 230.32, "e": 230.56}, {"w": " with", "s": 230.56, "e": 230.78}, {"w": " you.", "s": 230.78, "e": 230.96}]}]