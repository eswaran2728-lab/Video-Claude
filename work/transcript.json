[{"start": 8.52, "end": 12.3, "text": " At RedQ headquarters, every entry begins at the security gate.", "words": [{"w": " At", "s": 8.52, "e": 9.16}, {"w": " RedQ", "s": 9.16, "e": 9.56}, {"w": " headquarters,", "s": 9.56, "e": 10.0}, {"w": " every", "s": 10.38, "e": 10.62}, {"w": " entry", "s": 10.62, "e": 10.9}, {"w": " begins", "s": 10.9, "e": 11.28}, {"w": " at", "s": 11.28, "e": 11.46}, {"w": " the", "s": 11.46, "e": 11.6}, {"w": " security", "s": 11.6, "e": 11.9}, {"w": " gate.", "s": 11.9, "e": 12.3}]}, {"start": 17.52, "end": 22.42, "text": " One person scans, but another follows through the same opening. That is tailgating.", "words": [{"w": " One", "s": 17.52, "e": 18.16}, {"w": " person", "s": 18.16, "e": 18.46}, {"w": " scans,", "s": 18.46, "e": 18.78}, {"w": " but", "s": 19.28, "e": 19.4}, {"w": " another", "s": 19.4, "e": 19.62}, {"w": " follows", "s": 19.62, "e": 20.06}, {"w": " through", "s": 20.06, "e": 20.38}, {"w": " the", "s": 20.38, "e": 20.5}, {"w": " same", "s": 20.5, "e": 20.76}, {"w": " opening.", "s": 20.76, "e": 21.08}, {"w": " That", "s": 21.52, "e": 21.74}, {"w": " is", "s": 21.74, "e": 21.94}, {"w": " tailgating.", "s": 21.94, "e": 22.42}]}, {"start": 37.64, "end": 42.58, "text": " The correct way starts with a queue. The first person completes a face check and enters alone.", "words": [{"w": " The", "s": 37.64, "e": 38.18}, {"w": " correct", "s": 38.18, "e": 38.44}, {"w": " way", "s": 38.44, "e": 38.64}, {"w": " starts", "s": 38.64, "e": 38.86}, {"w": " with", "s": 38.86, "e": 39.1}, {"w": " a", "s": 39.1, "e": 39.22}, {"w": " queue.", "s": 39.22, "e": 39.44}, {"w": " The", "s": 39.92, "e": 40.02}, {"w": " first", "s": 40.02, "e": 40.22}, {"w": " person", "s": 40.22, "e": 40.54}, {"w": " completes", "s": 40.54, "e": 40.9}, {"w": " a", "s": 40.9, "e": 41.08}, {"w": " face", "s": 41.08, "e": 41.28}, {"w": " check", "s": 41.28, "e": 41.5}, {"w": " and", "s": 41.5, "e": 41.9}, {"w": " enters", "s": 41.9, "e": 42.24}, {"w": " alone.", "s": 42.24, "e": 42.58}]}, {"start": 47.800000000000004, "end": 52.74, "text": " The gate closes and resets. The next person completes a separate face check before entering.", "words": [{"w": " The", "s": 47.800000000000004, "e": 48.34}, {"w": " gate", "s": 48.34, "e": 48.5}, {"w": " closes", "s": 48.5, "e": 48.88}, {"w": " and", "s": 48.88, "e": 49.24}, {"w": " resets.", "s": 49.24, "e": 49.66}, {"w": " The", "s": 50.06, "e": 50.16}, {"w": " next", "s": 50.16, "e": 50.32}, {"w": " person", "s": 50.32, "e": 50.7}, {"w": " completes", "s": 50.7, "e": 51.04}, {"w": " a", "s": 51.04, "e": 51.26}, {"w": " separate", "s": 51.26, "e": 51.52}, {"w": " face", "s": 51.52, "e": 51.8}, {"w": " check", "s": 51.8, "e": 52.06}, {"w": " before", "s": 52.06, "e": 52.28}, {"w": " entering.", "s": 52.28, "e": 52.74}]}, {"start": 65.08, "end": 68.66, "text": " Having an ID badge isn't enough if nobody can see it.", "words": [{"w": " Having", "s": 65.08, "e": 65.72}, {"w": " an", "s": 65.72, "e": 65.9}, {"w": " ID", "s": 65.9, "e": 66.12}, {"w": " badge", "s": 66.12, "e": 66.58}, {"w": " isn't", "s": 66.58, "e": 66.92}, {"w": " enough", "s": 66.92, "e": 67.26}, {"w": " if", "s": 67.26, "e": 67.54}, {"w": " nobody", "s": 67.54, "e": 67.88}, {"w": " can", "s": 67.88, "e": 68.08}, {"w": " see", "s": 68.08, "e": 68.34}, {"w": " it.", "s": 68.34, "e": 68.66}]}, {"start": 72.86, "end": 75.72, "text": " Excuse me sir, may I see your ID badge?", "words": [{"w": " Excuse", "s": 72.86, "e": 73.5}, {"w": " me", "s": 73.5, "e": 73.74}, {"w": " sir,", "s": 73.74, "e": 73.94}, {"w": " may", "s": 74.48, "e": 74.66}, {"w": " I", "s": 74.66, "e": 74.78}, {"w": " see", "s": 74.78, "e": 74.96}, {"w": " your", "s": 74.96, "e": 75.08}, {"w": " ID", "s": 75.08, "e": 75.32}, {"w": " badge?", "s": 75.32, "e": 75.72}]}, {"start": 80.84, "end": 84.0, "text": " Please keep your badge visible and above your waist.", "words": [{"w": " Please", "s": 80.84, "e": 81.48}, {"w": " keep", "s": 81.48, "e": 81.74}, {"w": " yo